From ae1bf874bc7d9ea04bb598ceea89196aa32d9640 Mon Sep 17 00:00:00 2001
From: taudot <taudot@localhost>
Date: Tue, 3 Nov 2026 13:15:36 -0500
Subject: [PATCH 1/6] engine_tex: snapshot interval as TXP_SNAPSHOT_MS

---
 src/frontend/engine_tex.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/frontend/engine_tex.c b/src/frontend/engine_tex.c
index 5866b1b..790761a 100644
--- a/src/frontend/engine_tex.c
+++ b/src/frontend/engine_tex.c
@@ -516,7 +516,10 @@ static bool need_snapshot(fz_context *ctx, struct tex_engine *self, int time)
     last_time = 0;
   }
 
-  return time > 500 + last_time;
+#ifndef TXP_SNAPSHOT_MS
+#define TXP_SNAPSHOT_MS 500
+#endif
+  return time > TXP_SNAPSHOT_MS + last_time;
 }
 
 static void answer_query(fz_context *ctx, struct tex_engine *self, query_t *q)
