+    fz_begin_group(ctx, dc->dev, area, NULL, f->isolated, f->knockout, FZ_BLEND_NORMAL, alpha);
+  }
+  fz_run_display_list(ctx, f->list, dc->dev, shift, fz_infinite_rect, NULL);
+  if (group)
+    fz_end_group(ctx, dc->dev);
+  return 1;
+}
