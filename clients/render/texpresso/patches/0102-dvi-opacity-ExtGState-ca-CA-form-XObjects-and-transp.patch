+/* Taudot (MIT): forms are per page; unwind one left open (an unbalanced pdf:bxobj) and drop the lists. */
+void dvi_context_drop_forms(fz_context *ctx, dvi_context *dc)
+{
+  while (dc->form_depth > 0)
+  {
+    dc->form_depth--;
+    fz_device *list_dev = dc->dev;
+    dc->dev = dc->form_stack[dc->form_depth].saved_dev;
+    fz_try(ctx)
+      fz_close_device(ctx, list_dev);
+    fz_always(ctx)
+      fz_drop_device(ctx, list_dev);
+    fz_catch(ctx)
+      ;
+    fz_drop_display_list(ctx, dc->form_stack[dc->form_depth].list);
+  }
+  for (int i = 0; i < dc->form_count; i++)
+    fz_drop_display_list(ctx, dc->forms[i].list);
+  dc->form_count = 0;
+}
+
 void dvi_context_end_frame(fz_context *ctx, dvi_context *dc)
 {
+  dvi_context_drop_forms(ctx, dc);
   dvi_scratch_clear(ctx, &dc->scratch);
   dvi_context_set_device(ctx, dc, NULL);
 
