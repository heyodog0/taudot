Date: Tue, 3 Nov 2026 13:36:43 -0500
Subject: [PATCH 101/108] dvi: stroke state with room for the dash array; B*
 strokes in the line colour

---
 src/dvi/dvi_special.c      | 51 ++++++++++++++++++--------------------
 src/dvi/dvi_special.re2c.c | 51 ++++++++++++++++++--------------------
 2 files changed, 48 insertions(+), 54 deletions(-)

diff --git a/src/dvi/dvi_special.c b/src/dvi/dvi_special.c
index a88ea62..cdc7985 100644
--- a/src/dvi/dvi_special.c
+++ b/src/dvi/dvi_special.c
@@ -2844,16 +2844,31 @@ static void drop_path(fz_context *ctx, dvi_context *dc)
   }
 }
 
-static void get_stroke_state(fz_context *ctx, dvi_state *st, fz_stroke_state *stst)
+/* Taudot (MIT): MuPDF's fz_stroke_state ends in a flexible dash array, so a stack copy has no room for the
+   dashes and the memcpy overflowed (a fortify trap on any dashed TikZ line). Allocate one with room instead. */
+static fz_stroke_state *new_stroke_state(fz_context *ctx, dvi_state *st)
 {
-  *stst = fz_default_stroke_state;
+  fz_stroke_state *stst = fz_new_stroke_state_with_dash_len(ctx, st->gs.dash_len);
   stst->linewidth = st->gs.line_width;
   stst->linejoin = (int)st->gs.line_join;
-  stst->miterlimit = (int)st->gs.miter_limit;
+  stst->miterlimit = st->gs.miter_limit;
   stst->dash_cap = stst->start_cap = stst->end_cap = (int)st->gs.line_caps;
   stst->dash_len = st->gs.dash_len;
   memcpy(stst->dash_list, st->gs.dash, sizeof(float) * st->gs.dash_len);
   stst->dash_phase = st->gs.dash_phase;
+  return stst;
+}
+
+static void stroke_path(fz_context *ctx, dvi_context *dc, dvi_state *st, fz_path *path, fz_matrix ctm,
+                        const float *color)
+{
+  fz_stroke_state *stst = new_stroke_state(ctx, st);
+  fz_try(ctx)
+    fz_stroke_path(ctx, dc->dev, path, stst, ctm, device_cs(ctx), color, 1.0, color_params);
+  fz_always(ctx)
+    fz_drop_stroke_state(ctx, stst);
+  fz_catch(ctx)
+    fz_rethrow(ctx);
 }
 
 static bool
@@ -3005,14 +3020,11 @@ pdf_code(fz_context *ctx, dvi_context *dc, dvi_state *st, cursor_t cur, cursor_t
           if (dc->dev)
           {
             fz_matrix ctm = dvi_get_ctm(dc, st);
-            fz_stroke_state stst;
-            get_stroke_state(ctx, st, &stst);
             fz_path *path = get_path(ctx, dc);
             fz_closepath(ctx, path);
             fz_fill_path(ctx, dc->dev, path, 0, ctm, device_cs(ctx),
                          st->gs.colors.fill, 1.0, color_params);
-            fz_stroke_path(ctx, dc->dev, path, &stst, ctm, device_cs(ctx),
-                           st->gs.colors.line, 1.0, color_params);
+            stroke_path(ctx, dc, st, path, ctm, st->gs.colors.line);
           }
           drop_path(ctx, dc);
           break;
