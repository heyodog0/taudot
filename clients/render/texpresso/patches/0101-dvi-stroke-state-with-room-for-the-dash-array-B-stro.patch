-            fz_stroke_path(ctx, dc->dev, path, &stst, ctm, device_cs(ctx),
-                           st->gs.colors.line, 1.0, color_params);
+            stroke_path(ctx, dc, st, path, ctm, st->gs.colors.line);
           }
           drop_path(ctx, dc);
           break;
@@ -3052,13 +3058,10 @@ pdf_code(fz_context *ctx, dvi_context *dc, dvi_state *st, cursor_t cur, cursor_t
           if (dc->dev)
           {
             fz_matrix ctm = dvi_get_ctm(dc, st);
