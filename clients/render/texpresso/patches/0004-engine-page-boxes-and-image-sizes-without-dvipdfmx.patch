+/* taudot-pic.h: page boxes of included PDFs and pixel sizes of images, for
+ * \XeTeXpdffile, \XeTeXpicfile and \XeTeXpdfpagecount (xetex-pic.c).
+ *
+ * Copyright (c) 2026 the Taudot authors. MIT License: permission is hereby
+ * granted, free of charge, to any person obtaining a copy of this software and
+ * associated documentation files (the "Software"), to deal in the Software
+ * without restriction, including without limitation the rights to use, copy,
+ * modify, merge, publish, distribute, sublicense, and/or sell copies of the
+ * Software, and to permit persons to whom the Software is furnished to do so,
+ * subject to the following conditions: the above copyright notice and this
+ * permission notice shall be included in all copies or substantial portions of
+ * the Software. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND.
+ *
+ * Replaces the dvipdfmx (GPL) calls the engine used for this. The answers are
+ * the same as dvipdfmx's, value for value (checked against golden values,
+ * clients/render/texpresso/tests/pics in the Taudot repository).
+ */
+
+#ifndef TAUDOT_PIC_H
+#define TAUDOT_PIC_H
+
+#include "tectonic_bridge_core.h"
+
+typedef struct taudot_pdf taudot_pdf;
+
+/* Reads the whole file behind `handle`. Files we don't accept (unparseable,
+ * encrypted, a malformed /Version in the catalog) have 0 pages and no boxes. */
+taudot_pdf *taudot_pdf_open(rust_input_handle_t handle);
+void taudot_pdf_close(taudot_pdf *pdf);
+
+/* /Count of the page tree, 0 if missing. */
+int taudot_pdf_page_count(taudot_pdf *pdf);
+
+/* Box of page `page_no` as \XeTeXpdffile gives it (1-based; past the end is
+ * the last page, negative counts from the end, then at least 1): `box` is XeTeX's pdfbox_* (crop, media,
+ * bleed, trim, art; anything else means crop). Missing boxes fall back as in
+ * the PDF spec (crop to media, the others to crop), the result is clamped to
+ * the media box, and `matrix` (a b c d e f) applies the page's /Rotate.
+ * rect is llx lly urx ury. 0 on success, -1 if the page can't be used. */
+int taudot_pdf_page_box(taudot_pdf *pdf, int page_no, int box,
+                        double rect[4], double matrix[6]);
+
+/* JPEG, BMP or PNG: size in pixels and density (72 / dpi; 1.0 when the file
+ * doesn't say). 0 on success, nonzero if the format isn't recognised. */
+int taudot_image_info(rust_input_handle_t handle, unsigned int *width,
+                      unsigned int *height, double *xdensity, double *ydensity);
+
+/* Entry point of the Core Graphics helper (see taudot-pic.c); main() calls it when
+ * argv[1] is "-taudot-pdfinfo". */
+int taudot_pdfinfo_main(int argc, char **argv);
+
+#endif
