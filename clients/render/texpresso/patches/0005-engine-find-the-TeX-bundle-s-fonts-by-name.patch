new file mode 100644
index 0000000..34c8353
--- /dev/null
+++ b/src/engine/layout/taudot-fonts.h
@@ -0,0 +1,53 @@
+/* taudot-fonts.h: finding fonts of the TeX bundle by name.
+ *
+ * Copyright (c) 2026 the Taudot authors. MIT License: permission is hereby
+ * granted, free of charge, to any person obtaining a copy of this software and
+ * associated documentation files (the "Software"), to deal in the Software
+ * without restriction, including without limitation the rights to use, copy,
+ * modify, merge, publish, distribute, sublicense, and/or sell copies of the
+ * Software, and to permit persons to whom the Software is furnished to do so,
+ * subject to the following conditions: the above copyright notice and this
+ * permission notice shall be included in all copies or substantial portions of
+ * the Software. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND.
+ *
+ * On macOS, XeTeX looks fonts up by name through Core Text, which only knows
+ * installed fonts, so \setmainfont{Latin Modern Roman} found nothing in the
+ * Tectonic bundle. taudot-fontindex.c (generated) lists the names and style data
+ * of every font in one bundle; when Core Text misses, the font manager adds
+ * them to its caches and chooses among them by its usual rules, and the chosen
+ * font is loaded as "[file]". If the bundle isn't the indexed one, nothing
+ * changes. */
+
+#ifndef TAUDOT_FONTS_H
+#define TAUDOT_FONTS_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct taudot_indexed_font {
+    const char *file;    /* in the bundle */
+    int index;           /* face in a collection */
+    const char *ps;      /* PostScript name */
+    const char *family;  /* names as XeTeX's fontconfig build reads them, separated by \037 */
+    const char *style;
+    const char *full;
+    int flags;           /* 1: OS/2 present, 2: head, 4: post, 8: size feature, 16: variable font */
+    int weight, width, fs_selection, mac_style;
+    int italic_angle;    /* post, 16.16 */
+    int size[5];         /* GPOS size: design, subfamily ID, name code, min, max (decipoints) */
+};
+
+extern const char taudot_font_index_digest[];
+extern const int taudot_font_index_count;
+extern const struct taudot_indexed_font taudot_font_index[];
+
+/* If ref (a PlatformFontRef from the font manager) is an indexed bundle font,
+ * its file and face index. */
+int taudot_font_ref_file(const void *ref, const char **file, int *index);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
