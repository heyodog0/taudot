index 0000000..bc8380f
--- /dev/null
+++ b/src/engine/layout/taudot-fonts.cpp
@@ -0,0 +1,109 @@
+/* taudot-fonts.cpp: see taudot-fonts.h. Copyright (c) 2026 the Taudot authors, MIT
+ * License (full text in taudot-fonts.h). */
+
+#include "tectonic_xetex_layout.h"
+#ifdef XETEX_MAC
+#include "xetex-XeTeXFontMgr_Mac.h"
+#else
+#include "xetex-XeTeXFontMgr_FC.h"
+#endif
+#include "taudot-fonts.h"
+
+#include <math.h>
+#include <string.h>
+
+#include "tectonic_bridge_core.h"
+
+int taudot_font_ref_file(const void *ref, const char **file, int *index)
+{
+    const struct taudot_indexed_font *f = (const struct taudot_indexed_font *) ref;
+    if (f < taudot_font_index || f >= taudot_font_index + taudot_font_index_count)
+        return 0;
+    *file = f->file;
+    *index = f->index;
+    return 1;
+}
+
+/* The bundle's SHA256SUM must be the one the index was made from. */
+static bool bundle_matches()
+{
+    static int state = -1;
+    if (state >= 0)
+        return state;
+    state = 0;
+    rust_input_handle_t h = ttstub_input_open("SHA256SUM", TTBC_FILE_FORMAT_PROGRAM_DATA, 0);
+    if (h == NULL)
+        return state;
+    char buf[64];
+    size_t n = strlen(taudot_font_index_digest);
+    if (n <= sizeof buf && ttstub_input_read(h, buf, n) == (ssize_t) n && memcmp(buf, taudot_font_index_digest, n) == 0)
+        state = 1;
+    ttstub_input_close(h);
+    return state;
+}
+
+static void split(const char *s, std::list<std::string> *out)
+{
+    while (*s) {
+        const char *e = strchr(s, '\037');
+        if (!e)
+            e = s + strlen(s);
+        out->push_back(std::string(s, e));
+        s = *e ? e + 1 : e;
+    }
+}
+
+/* Adds every indexed font to the caches, once, with the attributes XeTeX would
+ * have read from the font itself (getOpSizeRecAndStyleFlags). Fonts are not
+ * opened. Done before any platform search, so for a name the bundle has, XeTeX
+ * chooses among the bundle's fonts as it would on Overleaf. */
+void
+XeTeXFontMgr::searchTaudotIndex()
+{
+    static bool done = false;
+    if (done)
+        return;
+    done = true;
+    if (!bundle_matches())
+        return;
+
+    for (int k = 0; k < taudot_font_index_count; k++) {
+        const struct taudot_indexed_font *f = &taudot_font_index[k];
+        PlatformFontRef ref = (PlatformFontRef) f;
+        if (f->ps[0] == 0 || m_psNameToFont.find(f->ps) != m_psNameToFont.end())
+            continue; // no PostScript name, or a duplicate of one
+
+        NameCollection names;
+        names.m_psName = f->ps;
+        split(f->family, &names.m_familyNames);
+        split(f->style, &names.m_styleNames);
+        split(f->full, &names.m_fullNames);
+
+        Font* font = new Font(ref);
+        if (f->flags & 8) {
+            font->opSizeInfo.designSize = f->size[0] * 72.27 / 72.0 / 10.0;
+            if (!(f->size[1] == 0 && f->size[2] == 0 && f->size[3] == 0 && f->size[4] == 0)) {
+                font->opSizeInfo.subFamilyID = f->size[1];
+                font->opSizeInfo.nameCode = f->size[2];
+                font->opSizeInfo.minSize = f->size[3] * 72.27 / 72.0 / 10.0;
+                font->opSizeInfo.maxSize = f->size[4] * 72.27 / 72.0 / 10.0;
+            }
+        }
+        if (f->flags & 1) {
+            font->weight = f->weight;
+            font->width = f->width;
+            font->isReg = (f->fs_selection & (1 << 6)) != 0;
+            font->isBold = (f->fs_selection & (1 << 5)) != 0;
+            font->isItalic = (f->fs_selection & (1 << 0)) != 0;
+        }
+        if (f->flags & 2) {
+            if (f->mac_style & 1)
+                font->isBold = true;
+            if (f->mac_style & 2)
+                font->isItalic = true;
+        }
+        if (f->flags & 4)
+            font->slant = (int)(1000 * (tan((-f->italic_angle / 65536.0) * M_PI / 180.0)));
+        addFontToMaps(font, &names);
+    }
+}
