+++ b/src/engine/layout/xetex-XeTeXFontMgr.cpp
@@ -108,6 +108,10 @@ XeTeXFontMgr::findFont(const char* name, char* variant, double ptSize)
     double dsize = 10.0;
     loaded_font_design_size = 655360L;
 
