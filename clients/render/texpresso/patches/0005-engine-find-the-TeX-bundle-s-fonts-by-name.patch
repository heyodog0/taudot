From 394c999c79983b4e23caa0068be47033b2acceef Mon Sep 17 00:00:00 2001
From: taudot <taudot@localhost>
Date: Tue, 3 Nov 2026 14:17:58 -0500
Subject: [PATCH 5/6] engine: find the TeX bundle's fonts by name

---
 src/engine/engine/xetex-ext.c            |   24 +-
 src/engine/layout/taudot-fontindex.c     | 2219 ++++++++++++++++++++++
 src/engine/layout/taudot-fonts.cpp       |  109 ++
 src/engine/layout/taudot-fonts.h         |   53 +
 src/engine/layout/xetex-XeTeXFontMgr.cpp |   15 +-
 src/engine/layout/xetex-XeTeXFontMgr.h   |    2 +
 6 files changed, 2420 insertions(+), 2 deletions(-)
 create mode 100644 src/engine/layout/taudot-fontindex.c
 create mode 100644 src/engine/layout/taudot-fonts.cpp
 create mode 100644 src/engine/layout/taudot-fonts.h

diff --git a/src/engine/engine/xetex-ext.c b/src/engine/engine/xetex-ext.c
index 11d8ade..bb610e3 100644
--- a/src/engine/engine/xetex-ext.c
+++ b/src/engine/engine/xetex-ext.c
@@ -38,6 +38,7 @@ authorization from the copyright holders.
 
 #include "xetex-core.h"
 #include "xetex-ext.h"
+#include "taudot-fonts.h" /* Taudot */
 #include "teckit-c-Engine.h"
 #include "xetex-swap.h"
 
@@ -788,11 +789,32 @@ find_native_font(char* uname, int32_t scaled_size)
     } else {
         fontRef = findFontByName(nameString, varString, Fix2D(scaled_size));
 
+        /* Taudot: a font of the TeX bundle found by name (taudot-fonts.h) is
+         * loaded from its file, as "[file:index]" with the variant and features
+         * that are left. */
+        int taudot_file = 0;
+        {
+            const char *tfile;
+            int tindex;
+            if (fontRef && taudot_font_ref_file(fontRef, &tfile, &tindex)) {
+                size_t n = strlen(tfile) + 32 + (varString ? strlen(varString) : 0) +
+                           (featString ? strlen(featString) : 0);
+                char *again = xmalloc(n);
+                snprintf(again, n, "[%s:%d]%s%s%s%s", tfile, tindex,
+                         varString && *varString ? "/" : "", varString && *varString ? varString : "",
+                         featString ? ":" : "", featString ? featString : "");
+                rval = find_native_font(again, scaled_size);
+                free(again);
+                fontRef = NULL;
+                taudot_file = 1;
+            }
+        }
+
         /* Tectonic: this used to live in XeTeXFontMgr::findFont(), but we needed to
          * move it here to preserve encapsulation.
          */
 
-        if (get_tracing_fonts_state() > 0) {
+        if (!taudot_file && get_tracing_fonts_state() > 0) {
             begin_diagnostic();
             print_nl(' ');
             print_c_string("-> ");
