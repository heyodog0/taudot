 	f3 = yyt4;
 #line 280 "dvi_special.re2c.c"
-	{ return color_parse_cmyk(state->line, f0, f1, f2, f3, lim); }
+	{ return color_parse_cmyk(ctx, state->line, f0, f1, f2, f3, lim); }
 #line 971 "dvi_special.c"
 yy78:
 	++cur;
@@ -975,7 +973,7 @@ yy78:
 	f2 = yyt3;
 	f3 = yyt4;
 #line 273 "dvi_special.re2c.c"
-	{ return color_parse_cmyk(state->fill, f0, f1, f2, f3, lim); }
+	{ return color_parse_cmyk(ctx, state->fill, f0, f1, f2, f3, lim); }
 #line 980 "dvi_special.c"
 }
 #line 305 "dvi_special.re2c.c"
@@ -3093,14 +3091,14 @@ pdf_code(fz_context *ctx, dvi_context *dc, dvi_state *st, cursor_t cur, cursor_t
         {
           float c[4];
           vstack_get_floats(ctx, stack, c, 4);
-          color_set_cmyk(st->gs.colors.line, c[0], c[1], c[2], c[3]);
+          color_set_cmyk(ctx, st->gs.colors.line, c[0], c[1], c[2], c[3]);
           break;
         }
         case PDF_OP_k:
         {
           float c[4];
           vstack_get_floats(ctx, stack, c, 4);
-          color_set_cmyk(st->gs.colors.fill, c[0], c[1], c[2], c[3]);
+          color_set_cmyk(ctx, st->gs.colors.fill, c[0], c[1], c[2], c[3]);
           break;
         }
 
@@ -3617,7 +3615,7 @@ yy292:
     if (!colorstack_push(ctx, dc, st, -1))
       return 0;
     if (f3)
-      color_set_cmyk(st->gs.colors.fill, pfloat(f0, lim), pfloat(f1, lim), pfloat(f2, lim), pfloat(f3, lim));
+      color_set_cmyk(ctx, st->gs.colors.fill, pfloat(f0, lim), pfloat(f1, lim), pfloat(f2, lim), pfloat(f3, lim));
     else if (f1)
       color_set_rgb(st->gs.colors.fill, pfloat(f0, lim), pfloat(f1, lim), pfloat(f2, lim));
     else
@@ -5022,7 +5020,7 @@ yy449:
 #line 1254 "dvi_special.re2c.c"
 	{
       return colorstack_push(ctx, dc, st, -1) &&
-             parse_color(&st->gs.colors, cur, lim);
+             parse_color(ctx, &st->gs.colors, cur, lim);
     }
 #line 4710 "dvi_special.c"
 yy450:
@@ -5188,7 +5186,7 @@ yy475:
 #line 1238 "dvi_special.re2c.c"
 	{
       return colorstack_push(ctx, dc, st, pint(i, lim)) &&
-             parse_pdfcolor(&st->gs.colors, cur, lim);
+             parse_pdfcolor(ctx, &st->gs.colors, cur, lim);
     }
 #line 4876 "dvi_special.c"
 yy476:
@@ -5242,7 +5240,7 @@ yy480:
 #line 1245 "dvi_special.re2c.c"
 	{
       return colorstack_init(ctx, dc, st, pint(i, lim)) &&
-             parse_pdfcolor(&st->gs.colors, cur, lim);
+             parse_pdfcolor(ctx, &st->gs.colors, cur, lim);
     }
 #line 4930 "dvi_special.c"
 }
@@ -5425,7 +5423,7 @@ yy490:
 #line 1287 "dvi_special.re2c.c"
 	{
     return colorstack_init(ctx, dc, st, pint(i, lim)) &&
-           parse_pdfcolor(&st->gs.colors, cur, lim);
+           parse_pdfcolor(ctx, &st->gs.colors, cur, lim);
   }
 #line 5113 "dvi_special.c"
 }
