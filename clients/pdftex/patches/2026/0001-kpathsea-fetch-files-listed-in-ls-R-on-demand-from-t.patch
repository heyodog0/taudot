diff --git a/texk/kpathsea/db.c b/texk/kpathsea/db.c
index fb4658c1..fc2178b8 100644
--- a/texk/kpathsea/db.c
+++ b/texk/kpathsea/db.c
@@ -31,6 +31,58 @@
 #include <kpathsea/tex-file.h>
 #include <kpathsea/variable.h>
 
+#ifndef _WIN32
+#include <spawn.h>
+#include <sys/wait.h>
+extern char **environ;
+#endif
+
+#include "taudot-store.c"
+
+/* Taudot: ls-R lists every file of a full TeX Live install, but only the files used so far are on disk. A hit
+   that is missing is fetched, then checked again: from the TeX Live store in this process when $TEXSTORE_URL is
+   set (taudot-store.c), else by the program $TAUDOT_TL_FETCH (argument: its path). Names that aren't in TeX Live
+   never reach the network. */
+static boolean
+taudot_fetch (kpathsea kpse, const_string path)
+{
+#ifndef _WIN32
+  static const_string cmd;
+  static int init;
+  pid_t pid;
+  int status;
+  char *argv[3];
+  posix_spawn_file_actions_t fa;
+  int r = taudot_store_fetch (kpse, path);
+
+  if (r >= 0)
+    return r && kpathsea_readable_file (kpse, (string) path) != NULL;
+  if (!init) {
+    cmd = getenv ("TAUDOT_TL_FETCH");
+    init = 1;
+  }
+  if (!cmd || !*cmd)
+    return false;
+  argv[0] = (char *) cmd;
+  argv[1] = (char *) path;
+  argv[2] = NULL;
+  posix_spawn_file_actions_init (&fa);
+  posix_spawn_file_actions_adddup2 (&fa, 2, 1); /* keep TeX's stdout clean */
+  if (posix_spawn (&pid, cmd, &fa, NULL, argv, environ) != 0) {
+    posix_spawn_file_actions_destroy (&fa);
+    return false;
+  }
+  posix_spawn_file_actions_destroy (&fa);
+  while (waitpid (pid, &status, 0) < 0)
+    if (errno != EINTR)
+      return false;
+  return WIFEXITED (status) && WEXITSTATUS (status) == 0
+         && kpathsea_readable_file (kpse, (string) path) != NULL;
+#else
+  return false;
+#endif
+}
+
