+#if !defined(W32UPTEXSYNCTEX)
+/* Taudot (the live engine; GPL). When the live runtime is on (its open-for-writing hook is set), the .synctex file
+   is one of its in-memory written files: each forked snapshot has its own copy, and nothing goes to the disk. The
+   text is written plain and gzipped when the file is closed, with gzopen("wb")'s parameters, so the bytes are the
+   same as stock's. rename and remove act on the in-memory files only. */
+extern boolean (*taudot_open_out_hook) (FILE **f_ptr, const char *name, const_string fopen_mode);
+extern char *taudot_vfile_data (const char *name, long *len);
+extern void taudot_vfile_replace (const char *name, char *buf, long len);
+extern int taudot_vfile_rename (const char *from, const char *to);
+extern int taudot_vfile_remove (const char *name);
+extern void (*taudot_synctex_gzip_hook) (const char *name);
+extern int taudot_synctex_gzip_pending;
+#define TAUDOT_SYNCTEX (taudot_open_out_hook != NULL)
+#define rename(a, b) (TAUDOT_SYNCTEX ? taudot_vfile_rename ((a), (b)) : rename ((a), (b)))
+#define remove(a) (TAUDOT_SYNCTEX ? taudot_vfile_remove (a) : remove (a))
+
+static void taudot_synctex_gzip (const char *name)
+{
+    long len = 0;
+    char *in = taudot_vfile_data (name, &len), *out;
+    z_stream z;
+    uLong cap;
+    if (!in)
+        return;
+    memset (&z, 0, sizeof z);
+    if (deflateInit2 (&z, Z_DEFAULT_COMPRESSION, Z_DEFLATED, MAX_WBITS + 16, 8, Z_DEFAULT_STRATEGY) != Z_OK)
+        return;
+    cap = deflateBound (&z, (uLong) len) + 64;
+    out = xmalloc (cap);
+    z.next_in = (Bytef *) in;
+    z.avail_in = (uInt) len;
+    z.next_out = (Bytef *) out;
+    z.avail_out = (uInt) cap;
+    if (deflate (&z, Z_FINISH) == Z_STREAM_END)
+        taudot_vfile_replace (name, out, (long) (cap - z.avail_out));
+    else
+        free (out);
+    deflateEnd (&z);
+}
+#else
+#define TAUDOT_SYNCTEX 0
+#endif
+
+/* Close the synctex file, whichever kind it is. */
+static void synctex_close_file (void)
+{
+    if (TAUDOT_SYNCTEX) {
+        /* gzipped later, by the live runtime, once the PDF is out (taudot_synctex_gzip_hook) */
+        fclose ((FILE *) SYNCTEX_FILE);
+        taudot_synctex_gzip_hook = taudot_synctex_gzip;
+        taudot_synctex_gzip_pending = !SYNCTEX_NO_GZ;
+    } else if (SYNCTEX_NO_GZ) {
+        xfclose ((FILE *) SYNCTEX_FILE, synctex_ctxt.busy_name);
+    } else {
+        gzclose ((gzFile) SYNCTEX_FILE);
+    }
+}
