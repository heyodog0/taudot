+static void tl_dump (struct tl_vfile *v, const char *name);
+
+/* Set by synctex.c when it closes its file: gzip it (after the PDF is out). */
+void (*taudot_synctex_gzip_hook) (const char *name) = NULL;
+int taudot_synctex_gzip_pending = 0;
+
+/* The finished .synctex(.gz) as OUT/<stem>.synctex[.gz]; returns the name written there, or NULL. */
+static const char *
+tl_dump_synctex (const char *stem)
+{
+  static char name[96];
+  int gz;
+  if (!tl_synctex)
+    return NULL;
+  gz = strcmp (tl_synctex->abs + strlen (tl_synctex->abs) - 3, ".gz") == 0;
+  if (gz && taudot_synctex_gzip_pending && taudot_synctex_gzip_hook) {
+    taudot_synctex_gzip_hook (tl_synctex->abs);
+    taudot_synctex_gzip_pending = 0;
+  }
+  snprintf (name, sizeof name, "%s.synctex%s", stem, gz ? ".gz" : "");
+  tl_dump (tl_synctex, name);
+  return name;
+}
+
+/* For SyncTeX (synctex.c): its file is one of these. Names as SyncTeX gives them (relative to the cwd). */
+char *
+taudot_vfile_data (const char *name, long *len)
+{
+  char *abs = tl_absname (name);
+  struct tl_vfile *v = tl_vfind (abs);
+  free (abs);
+  if (!v)
+    return NULL;
+  if (v->f)
+    fflush (v->f);
+  *len = v->len;
+  return v->buf;
+}
+
+void
+taudot_vfile_replace (const char *name, char *buf, long len)
+{
+  char *abs = tl_absname (name);
+  struct tl_vfile *v = tl_vfind (abs);
+  free (abs);
+  if (!v) {
+    free (buf);
+    return;
+  }
+  free (v->buf);
+  v->buf = buf;
+  v->len = v->pos = v->cap = len;
+}
+
+int
+taudot_vfile_remove (const char *name)
+{
+  char *abs = tl_absname (name);
+  int i;
+  for (i = 0; i < tl_nvfiles; i++)
+    if (strcmp (tl_vfiles[i]->abs, abs) == 0) {
+      struct tl_vfile *v = tl_vfiles[i];
+      if (v == tl_synctex)
+        tl_synctex = NULL;
+      free (v->buf);
+      free (v->abs);
+      free (v);
+      tl_vfiles[i] = tl_vfiles[--tl_nvfiles];
+      free (abs);
+      return 0;
+    }
+  free (abs);
+  errno = ENOENT;
+  return -1;
+}
+
+int
+taudot_vfile_rename (const char *from, const char *to)
+{
+  char *a = tl_absname (from), *b = tl_absname (to);
+  struct tl_vfile *v = tl_vfind (a);
+  free (a);
+  if (!v) {
+    free (b);
+    errno = ENOENT;
+    return -1;
+  }
+  taudot_vfile_remove (to);
+  free (v->abs);
+  v->abs = b;
+  tl_synctex = v;
+  return 0;
+}
