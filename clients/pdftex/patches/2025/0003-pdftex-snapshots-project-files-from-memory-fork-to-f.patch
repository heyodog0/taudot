--- /dev/null
+++ b/texk/web2c/lib/taudot-live.c
@@ -0,0 +1,595 @@
+/* taudot-live.c: the live pdfTeX of Taudot (TeXpresso's method on pdfTeX).
+
+   Copyright 2026 Ryan Truong. GPL-2.0-or-later, like pdfTeX.
+
+   #included at the end of lib/texmfmp.c for pdfTeX only. Off unless TAUDOT_LIVE_FD is set; then:
+
+   - Files read from the project directory (TAUDOT_PROJECT) are loaded whole and served from memory, unbuffered,
+     so the run knows exactly how many bytes of each it has read (its "extent"), and a resumed run can swap in the
+     edited text at the same position.
+   - Every file the run writes (.pdf, .log, .aux, ...) stays in memory and shadows the file on disk for later reads
+     in the same run. A forked process therefore never shares an output file with another.
+   - Snapshots: before reading a line of a project file, at most every TAUDOT_SNAPSHOT_MS, the runner forks. The
+     parent stops and waits as the snapshot; the child carries on as the runner. When the driver kills a
+     snapshot's child with SIGKILL, the snapshot forks a new runner from its own state (staying a snapshot), and
+     that runner reloads the project files from disk and reads the driver's TAUDOT_LIVE_OUT/ctl.
+   - Fork-to-finish: after a page is shipped, if the runner has read past the edit named in ctl (or
+     TAUDOT_FINISH_ALL is set), it forks a grandchild that runs close_files_and_terminate (fonts, page tree, xref)
+     and writes the PDF of the pages so far to TAUDOT_LIVE_OUT. The runner carries on.
+   - At the end of the run, the runner writes final-<seq>.pdf and .log and then waits (it can be rolled back too).
+
+   Messages to the driver are datagrams on TAUDOT_LIVE_FD, one line of fields each (see clients/pdftex/README.md).
+   Times are CLOCK_MONOTONIC microseconds, shared with the driver. */
+
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <time.h>
+#include <unistd.h>
+
+extern FILE *(*taudot_open_in_hook) (const char *name, int filefmt, int stage);
+extern boolean (*taudot_open_out_hook) (FILE **f_ptr, const char *name, const_string fopen_mode);
+extern void (*taudot_exit_hook) (int);
+
+static int tl_on = 0;            /* live mode */
+static int tl_fd = -1;           /* datagram socket to the driver */
+static char *tl_proj;            /* realpath of the project directory, with a trailing '/' */
+static size_t tl_proj_len;
+static char *tl_out;             /* driver's output directory */
+static char *tl_cwd;             /* for absolute names of written files */
+static uint64_t tl_snap_us = 50000;
+static uint64_t tl_last_snap;    /* 0: snapshot at the first project line */
+static pid_t tl_parent;          /* our parent when we became the runner; orphans exit */
+static int tl_finishing = 0;     /* in a fork-to-finish grandchild */
+static int tl_finish_all = 0;
+static int tl_seq = 0;           /* edit number from ctl; 0 for the first run */
+static char tl_watch[PATH_MAX];  /* finish once this file is read past tl_watch_off */
+static long tl_watch_off = -1;
+
+static uint64_t
+tl_now (void)
+{
+  struct timespec ts;
+  clock_gettime (CLOCK_MONOTONIC, &ts);
+  return (uint64_t) ts.tv_sec * 1000000u + ts.tv_nsec / 1000;
+}
+
+static void
+tl_send (const char *fmt, ...)
+{
+  char buf[32768];
+  va_list ap;
+  int n;
+  va_start (ap, fmt);
+  n = vsnprintf (buf, sizeof buf, fmt, ap);
+  va_end (ap);
+  if (n < 0)
+    return;
+  if (n >= (int) sizeof buf)
+    n = sizeof buf - 1;
+  while (send (tl_fd, buf, n, 0) < 0 && errno == EINTR)
+    ;
+}
+
+/* ---- project files: read from memory, extents tracked ---- */
+
+struct tl_track { char *rel; char *abs; long hw; int eof; };   /* one per project file ever opened */
+static struct tl_track tl_tracks[512];
+static int tl_ntracks = 0;
+
+struct tl_reader { int track; char *buf; long len, pos; };    /* one per open FILE; track < 0: a shadow copy */
+static struct tl_reader *tl_open_readers[512];
+static int tl_nreaders = 0;
+
+static int tl_read (void *c, char *buf, int n);
+
+static int
+tl_is_tracked (FILE *f)
+{
+  return f && f->_read == tl_read && ((struct tl_reader *) f->_cookie)->track >= 0;
+}
+
+static int
+tl_read (void *c, char *buf, int n)
+{
+  struct tl_reader *r = c;
+  long k = r->len - r->pos;
+  if (k <= 0) {
+    if (r->track >= 0)
+      tl_tracks[r->track].eof = 1;
+    return 0;
+  }
+  if (k > n)
+    k = n;
+  memcpy (buf, r->buf + r->pos, k);
+  r->pos += k;
+  if (r->track >= 0 && r->pos > tl_tracks[r->track].hw)
+    tl_tracks[r->track].hw = r->pos;
+  return (int) k;
+}
+
+static fpos_t
+tl_rseek (void *c, fpos_t off, int whence)
+{
+  struct tl_reader *r = c;
+  long p = whence == SEEK_SET ? off : whence == SEEK_CUR ? r->pos + off : r->len + off;
+  if (p < 0)
+    return -1;
+  r->pos = p;
+  return p;
+}
+
+static int
+tl_rclose (void *c)
+{
+  struct tl_reader *r = c;
+  int i;
+  for (i = 0; i < tl_nreaders; i++)
+    if (tl_open_readers[i] == r) {
+      tl_open_readers[i] = tl_open_readers[--tl_nreaders];
+      break;
+    }
+  free (r->buf);
+  free (r);
+  return 0;
+}
+
+static char *
+tl_slurp (const char *path, long *len)
+{
+  int fd = open (path, O_RDONLY);
+  struct stat st;
+  char *buf;
+  long got = 0;
+  if (fd < 0)
+    return NULL;
+  if (fstat (fd, &st) < 0) {
+    close (fd);
+    return NULL;
+  }
+  buf = xmalloc (st.st_size + 1);
+  while (got < st.st_size) {
+    ssize_t n = (read) (fd, buf + got, st.st_size - got);
+    if (n < 0 && errno == EINTR)
+      continue;
+    if (n <= 0)
+      break;
+    got += n;
+  }
+  close (fd);
+  *len = got;
+  return buf;
+}
+
+static FILE *
+tl_reader_file (int track, char *buf, long len)
+{
+  struct tl_reader *r = xmalloc (sizeof *r);
+  FILE *f;
+  r->track = track;
+  r->buf = buf;
+  r->len = len;
+  r->pos = 0;
+  f = funopen (r, tl_read, NULL, tl_rseek, tl_rclose);
+  if (!f) {
+    free (buf);
+    free (r);
+    return NULL;
+  }
+  setvbuf (f, NULL, _IONBF, 0);  /* every byte TeX reads is counted, none read ahead */
+  if (track >= 0 && tl_nreaders < 512)
+    tl_open_readers[tl_nreaders++] = r;
+  return f;
+}
+
+/* ---- written files: in memory ---- */
+
+struct tl_vfile { char *abs; char *buf; long len, cap, pos; FILE *f; };
+static struct tl_vfile *tl_vfiles[256];
+static int tl_nvfiles = 0;
+static struct tl_vfile *tl_pdf, *tl_log;
+
+static char *
+tl_absname (const char *name)
+{
+  if (name[0] == '/')
+    return xstrdup (name);
+  if (name[0] == '.' && name[1] == '/')
+    name += 2;
+  return concat3 (tl_cwd, "/", name);
+}
+
+static struct tl_vfile *
+tl_vfind (const char *abs)
+{
+  int i;
+  for (i = 0; i < tl_nvfiles; i++)
+    if (strcmp (tl_vfiles[i]->abs, abs) == 0)
+      return tl_vfiles[i];
+  return NULL;
+}
+
+static int
+tl_write (void *c, const char *buf, int n)
+{
+  struct tl_vfile *v = c;
+  if (v->pos + n > v->cap) {
+    long cap = v->cap ? v->cap : 65536;
+    while (cap < v->pos + n)
+      cap *= 2;
+    v->buf = xrealloc (v->buf, cap);
+    v->cap = cap;
+  }
+  if (v->pos > v->len)
+    memset (v->buf + v->len, 0, v->pos - v->len);
+  memcpy (v->buf + v->pos, buf, n);
+  v->pos += n;
+  if (v->pos > v->len)
+    v->len = v->pos;
+  return n;
+}
+
+static fpos_t
+tl_wseek (void *c, fpos_t off, int whence)
+{
+  struct tl_vfile *v = c;
+  long p = whence == SEEK_SET ? off : whence == SEEK_CUR ? v->pos + off : v->len + off;
+  if (p < 0)
+    return -1;
+  v->pos = p;
+  return p;
+}
+
+static int
+tl_wclose (void *c)
+{
+  ((struct tl_vfile *) c)->f = NULL;
+  return 0;
+}
+
+static boolean
+tl_open_out (FILE **f_ptr, const char *name, const_string mode)
+{
+  char *abs = tl_absname (name);
+  struct tl_vfile *v = tl_vfind (abs);
+  size_t n = strlen (abs);
+  if (!v) {
+    if (tl_nvfiles == 256) {
+      free (abs);
+      *f_ptr = NULL;
+      return false;
+    }
+    v = xcalloc (1, sizeof *v);
+    v->abs = abs;
+    tl_vfiles[tl_nvfiles++] = v;
+  } else
+    free (abs);
+  if (v->f)
+    fclose (v->f);
+  v->len = v->pos = 0;
+  v->f = *f_ptr = funopen (v, NULL, tl_write, tl_wseek, tl_wclose);
+  if (n > 4 && strcmp (v->abs + n - 4, ".pdf") == 0)
+    tl_pdf = v;
+  if (n > 4 && strcmp (v->abs + n - 4, ".log") == 0)
+    tl_log = v;
+  return *f_ptr != NULL;
+}
+
+static FILE *
+tl_open_shadow (const char *name)
+{
+  char *abs = tl_absname (name);
+  struct tl_vfile *v = tl_vfind (abs);
+  char *copy;
+  free (abs);
+  if (!v)
+    return NULL;
+  if (v->f)
+    fflush (v->f);
+  copy = xmalloc (v->len + 1);
+  memcpy (copy, v->buf, v->len);
+  return tl_reader_file (-1, copy, v->len);
+}
+
+static FILE *
+tl_open_in (const char *name, int filefmt, int stage)
+{
+  char real[PATH_MAX];
+  long len;
+  char *buf;
+  int i;
+  FILE *f;
+  if (filefmt == DUMP_FORMAT)
+    return NULL;
+  if (stage == 0) {
+    if (filefmt == kpse_tex_format) {
+      char *withtex = concat (name, ".tex");
+      f = tl_open_shadow (withtex);
+      free (withtex);
+      if (f)
+        return f;
+    }
+    return tl_open_shadow (name);
+  }
+  if ((f = tl_open_shadow (name)))
+    return f;
+  if (!realpath (name, real) || strncmp (real, tl_proj, tl_proj_len) != 0)
+    return NULL;
+  for (i = 0; i < tl_ntracks; i++)
+    if (strcmp (tl_tracks[i].abs, real) == 0)
+      break;
+  if (i == tl_ntracks) {
+    if (tl_ntracks == 512)
+      return NULL;
+    tl_tracks[i].abs = xstrdup (real);
+    tl_tracks[i].rel = xstrdup (real + tl_proj_len);
+    tl_tracks[i].hw = 0;
+    tl_tracks[i].eof = 0;
+    tl_ntracks++;
+  }
+  if (!(buf = tl_slurp (real, &len)))
+    return NULL;
+  return tl_reader_file (i, buf, len);
+}
+
+/* ---- forks ---- */
+
+/* A forked child shares the open file descriptions of its parent, offsets included. Give each read-only file
+   (images, fonts: everything not served from memory) a description of its own, at the same offset, so a
+   runner reading ahead can't move a snapshot's files. */
+static void
+tl_unshare_fds (void)
+{
+  int fd, max = getdtablesize ();
+  if (max > 4096)
+    max = 4096;
+  for (fd = 3; fd < max; fd++) {
+    struct stat st;
+    char path[PATH_MAX];
+    int fl, nfd;
+    off_t off;
+    if (fd == tl_fd || fstat (fd, &st) < 0 || !S_ISREG (st.st_mode))
+      continue;
+    fl = fcntl (fd, F_GETFL);
+    if (fl < 0 || (fl & O_ACCMODE) != O_RDONLY || fcntl (fd, F_GETPATH, path) < 0)
+      continue;
+    off = lseek (fd, 0, SEEK_CUR);
+    nfd = open (path, O_RDONLY);
+    if (nfd < 0)
+      continue;
+    lseek (nfd, off, SEEK_SET);
+    dup2 (nfd, fd);
+    close (nfd);
+  }
+}
+
+static void
+tl_send_snapshot (void)
+{
+  char msg[30000];
+  int i, n;
+  n = snprintf (msg, sizeof msg, "S %d %d %llu %d\n", (int) getppid (), (int) getpid (),
+                (unsigned long long) tl_last_snap, tl_ntracks);
+  for (i = 0; i < tl_ntracks && n < (int) sizeof msg - PATH_MAX - 32; i++)
+    n += snprintf (msg + n, sizeof msg - n, "%ld %s\n", tl_tracks[i].hw + tl_tracks[i].eof, tl_tracks[i].rel);
+  tl_send ("%s", msg);
+}
+
+static void
+tl_read_ctl (void)
+{
+  char *path = concat (tl_out, "/ctl");
+  FILE *f = fopen (path, "r");
+  free (path);
+  tl_watch_off = -1;
+  if (!f)
+    return;
+  if (fscanf (f, "%d %ld %1023s", &tl_seq, &tl_watch_off, tl_watch) != 3)
+    tl_watch_off = -1;
+  fclose (f);
+}
+
+static void
+tl_reload (void)
+{
+  int i;
+  for (i = 0; i < tl_nreaders; i++) {
+    struct tl_reader *r = tl_open_readers[i];
+    long len;
+    char *buf = tl_slurp (tl_tracks[r->track].abs, &len);
+    if (buf) {
+      free (r->buf);
+      r->buf = buf;
+      r->len = len;
+    }
+  }
+}
+
+/* The parent side of a snapshot: wait for the runner; when the driver kills it, start a new one. Returns in the
+   new runner. */
+static void
+tl_be_snapshot (pid_t child)
+{
+  for (;;) {
+    int st;
+    pid_t c;
+    while (waitpid (child, &st, 0) < 0)
+      if (errno != EINTR)
+        _exit (3);
+    if (!(WIFSIGNALED (st) && WTERMSIG (st) == SIGKILL)) {
+      tl_send ("X %d %d %d\n", (int) getpid (), (int) child, st);
+      _exit (3);
+    }
+    fflush (stdout);
+    c = fork ();
+    if (c < 0)
+      _exit (3);
+    if (c == 0) {
+      tl_parent = getppid ();
+      tl_unshare_fds ();
+      tl_reload ();
+      tl_read_ctl ();
+      tl_last_snap = tl_now ();
+      tl_send ("R %d %d %d %llu\n", (int) getppid (), (int) getpid (), tl_seq, (unsigned long long) tl_last_snap);
+      return;
+    }
+    child = c;
+  }
+}
+
+static void
+tl_before_line (FILE *f)
+{
+  pid_t c;
+  uint64_t t;
+  if (getppid () != tl_parent)
+    _exit (0);  /* our snapshot was killed: we are a stale runner */
+  if (!tl_is_tracked (f))
+    return;
+  t = tl_now ();
+  if (tl_last_snap && t - tl_last_snap < tl_snap_us)
+    return;
+  fflush (stdout);
+  c = fork ();
+  if (c < 0)
+    return;
+  if (c == 0) {
+    tl_parent = getppid ();
+    tl_last_snap = t;
+    tl_unshare_fds ();
+    tl_send_snapshot ();
+    return;
+  }
+  tl_be_snapshot (c);
+}
+
+static void
+tl_dump (struct tl_vfile *v, const char *name)
+{
+  char *path, *tmp;
+  int fd;
+  long done = 0;
+  if (!v)
+    return;
+  if (v->f)
+    fflush (v->f);
+  path = concat3 (tl_out, "/", name);
+  tmp = concat (path, ".tmp");
+  fd = open (tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+  if (fd >= 0) {
+    while (done < v->len) {
+      ssize_t n = (write) (fd, v->buf + done, v->len - done);
+      if (n < 0 && errno == EINTR)
+        continue;
+      if (n <= 0)
+        break;
+      done += n;
+    }
+    close (fd);
+    rename (tmp, path);
+  }
+  free (tmp);
+  free (path);
+}
+
+static void
+tl_finish (void)
+{
+  uint64_t t0 = tl_now (), t1, t2, t3;
+  pid_t c;
+  fflush (stdout);
+  c = fork ();
+  if (c < 0)
+    return;
+  if (c == 0) {
+    char name[64];
+    if (fork () != 0)
+      _exit (0);
+    t1 = tl_now ();
+    tl_finishing = 1;
+    tl_unshare_fds ();
+    closefilesandterminate ();
+    t2 = tl_now ();
+    snprintf (name, sizeof name, "pdf-%d-%d.pdf", tl_seq, (int) getpid ());
+    tl_dump (tl_pdf, name);
+    t3 = tl_now ();
+    tl_send ("P %d %d %d %llu %llu %llu %llu %s\n", (int) getpid (), tl_seq, (int) totalpages,
+             (unsigned long long) t0, (unsigned long long) t1, (unsigned long long) t2,
+             (unsigned long long) t3, name);
+    _exit (0);
+  }
+  while (waitpid (c, NULL, 0) < 0 && errno == EINTR)
+    ;
+}
+
+void
+taudotshipped (void)
+{
+  int i;
+  if (!tl_on || tl_finishing)
+    return;
+  tl_send ("p %d %d %llu\n", (int) getpid (), (int) totalpages, (unsigned long long) tl_now ());
+  if (tl_finish_all) {
+    tl_finish ();
+    return;
+  }
+  if (tl_watch_off < 0)
+    return;
+  for (i = 0; i < tl_ntracks; i++)
+    if (strcmp (tl_tracks[i].rel, tl_watch) == 0)
+      break;
+  if (i < tl_ntracks && tl_tracks[i].hw + tl_tracks[i].eof > tl_watch_off) {
+    tl_watch_off = -1;
+    tl_finish ();
+  }
+}
+
+static void
+tl_exit (int code)
+{
+  char name[64];
+  if (tl_finishing)
+    _exit (code);
+  snprintf (name, sizeof name, "final-%d.pdf", tl_seq);
+  tl_dump (tl_pdf, name);
+  snprintf (name, sizeof name, "final-%d.log", tl_seq);
+  tl_dump (tl_log, name);
+  tl_send ("E %d %d %d %d %llu\n", (int) getpid (), tl_seq, (int) totalpages, code, (unsigned long long) tl_now ());
+  /* Stay: the snapshot that made us resumes only when we are killed. */
+  for (;;) {
+    pause ();
+    if (getppid () != tl_parent)
+      _exit (0);
+  }
+}
+
+static void
+taudot_live_init (void)
+{
+  const char *s = getenv ("TAUDOT_LIVE_FD");
+  char real[PATH_MAX];
+  if (!s || !*s)
+    return;
+  tl_fd = atoi (s);
+  if (!realpath (getenv ("TAUDOT_PROJECT") ? getenv ("TAUDOT_PROJECT") : ".", real)) {
+    fprintf (stderr, "taudot-live: bad TAUDOT_PROJECT\n");
+    exit (2);
+  }
+  tl_proj = concat (real, "/");
+  tl_proj_len = strlen (tl_proj);
+  tl_out = xstrdup (getenv ("TAUDOT_LIVE_OUT") ? getenv ("TAUDOT_LIVE_OUT") : ".");
+  tl_cwd = xgetcwd ();
+  if ((s = getenv ("TAUDOT_SNAPSHOT_MS")))
+    tl_snap_us = (uint64_t) (atof (s) * 1000);
+  tl_finish_all = getenv ("TAUDOT_FINISH_ALL") != NULL;
+  tl_parent = getppid ();
+  taudot_open_in_hook = tl_open_in;
+  taudot_open_out_hook = tl_open_out;
+  taudot_exit_hook = tl_exit;
+  tl_on = 1;
+}
diff --git a/texk/web2c/lib/texmfmp.c b/texk/web2c/lib/texmfmp.c
index d7d4d254..fc4e1fa4 100644
--- a/texk/web2c/lib/texmfmp.c
+++ b/texk/web2c/lib/texmfmp.c
@@ -784,6 +784,10 @@ static string
 normalize_quotes (const_string name, const_string mesg);
 #endif /* WIN32 */
 
+#if defined(pdfTeX)
+#include "taudot-live.c" /* Taudot: the live engine */
+#endif
+
 /* maininit, called from main() - this is most of the main routine,
    including our C-level option handling and concomitant kpse setup.
    The original TeX/MF code for handling first lines is still live, and
@@ -799,6 +803,9 @@ maininit (int ac, string *av)
   /* Save to pass along to topenin.  */
   argc = ac;
   argv = av;
+#if defined(pdfTeX)
+  taudot_live_init ();
+#endif
 
   /* Must be initialized before options are parsed.  */
   interactionoption = 4;
@@ -2574,6 +2581,11 @@ input_line (FILE *f)
 {
   int i = EOF;
 
